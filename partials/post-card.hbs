<article class="entry-card">
    <a href="{{url}}">
        <span class="entry-meta">{{date format="DD MMM YYYY"}}{{#if primary_tag}} / {{primary_tag.name}}{{/if}}</span>
        <h3>{{title}} <span aria-hidden="true">↗</span></h3>
        <p>{{excerpt words="23"}}</p>
        {{#unless access}}<span class="entry-meta">Members-only entry</span>{{/unless}}
    </a>
</article>
