{{!< default}}
{{#post}}
<article class="article paper-page {{post_class}}">
    <header class="article-header">
        <a class="back-link" href="{{@site.url}}/#writing">← Back to the notebook</a>
        <p class="entry-meta">{{date format="DD MMM YYYY"}} · {{reading_time}}</p>
        <h1>{{title}}</h1>
        {{#if custom_excerpt}}<p class="article-excerpt">{{custom_excerpt}}</p>{{/if}}
        <p class="byline">{{authors}}</p>
        {{#if feature_image}}
            <figure class="feature-image">
                <img src="{{img_url feature_image size="large"}}" alt="{{feature_image_alt}}" width="1600" loading="eager">
                {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
            </figure>
        {{/if}}
    </header>
    <div class="gh-content">{{content}}</div>
    {{#if tags}}<div class="article-tags">{{tags separator=" / "}}</div>{{/if}}
    <div class="article-comments">{{comments}}</div>
</article>
{{/post}}
