{{!< default}}
<div class="binding" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div>
<div class="journal-sections">
    <section class="spread home-spread" id="home" aria-labelledby="home-title" data-journal-page>
        <div class="paper-page cover-page">
            <div class="page-eyebrow"><span>ISSUE NO. 001 / NOT A PERSONAL BRAND™</span><span aria-hidden="true">↘</span></div>
            <h1 id="home-title" class="name-collage"><span class="name-text">Erin Mikail Staples</span><span class="first-name" aria-hidden="true"><span class="cut c1">E</span><span class="cut c2">R</span><span class="cut c3">I</span><span class="cut c4">N</span></span><span class="middle-name" aria-hidden="true"><span class="cut c5">M</span><span class="cut c6">I</span><span class="cut c7">K</span><span class="cut c8">A</span><span class="cut c2">I</span><span class="cut c4">L</span></span><span class="last-name" aria-hidden="true"><span class="cut c3">S</span><span class="cut c8">T</span><span class="cut c1">A</span><span class="cut c6">P</span><span class="cut c5">L</span><span class="cut c7">E</span><span class="cut c2">S</span></span></h1>
            <span class="handwritten name-note" aria-hidden="true">yes, like the office supply. no, not a corporation.</span>
            <div class="cover-collection">
                <a class="portrait-print" href="#about" data-section-link>
                    <span class="tape tape-top" aria-hidden="true"></span>
                    <svg class="foil-sticker foil-portrait" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#shape-heart" fill="url(#foil-holo)"/><use href="#shape-heart" fill="url(#foil-glare)"/></svg>
                    <span class="portrait-image">
                        <img src="{{#if @custom.portrait}}{{img_url @custom.portrait size="large"}}{{else}}{{asset "images/erin-headshot.jpg"}}{{/if}}" width="800" height="836" alt="Erin Mikail Staples, in glasses and a black jacket, at a developer event">
                        <svg class="portrait-doodles" viewBox="0 0 800 836" aria-hidden="true" focusable="false">
                            <g fill="none" stroke-linecap="round" stroke-linejoin="round">
                                <path class="doodle-mustache" pathLength="1" d="M517 329c-16-15-30 16-46 7-9-5-8-14-2-16m48 9c14-16 30 13 46 3 8-5 7-14 1-17M477 337c14 9 27-13 40-8 14-7 28 15 41 5" stroke="#171717" stroke-width="7"/>
                                <path class="doodle-tiara doodle-outline" pathLength="1" d="m440 171-15-60 43 28 28-56 25 53 43-44-2 65c-39-9-82-2-122 14Zm4 9c42-15 81-19 119-12" stroke="#171717" stroke-width="13"/>
                                <path class="doodle-tiara" pathLength="1" d="m440 171-15-60 43 28 28-56 25 53 43-44-2 65c-39-9-82-2-122 14Zm4 9c42-15 81-19 119-12" stroke="#f27ed5" stroke-width="7"/>
                                <path class="doodle-stars" pathLength="1" d="m668 214 5 22 23 4-22 8-3 24-9-21-22-3 20-10 8-24ZM358 175l5 16 16 3-14 8-3 17-7-15-16-4 14-7 5-18M650 325l14 2m-7-9-1 16M387 282l13 2m-6-9-1 16" stroke="#fffdf6" stroke-width="6"/>
                            </g>
                        </svg>
                    </span>
                    <span class="photo-caption">HOWDY. THIS IS MY FACE. ↗</span>
                </a>
                <div class="small-collection">
                    <a class="camp-patch" href="#about" data-section-link><img src="{{asset "images/patch-about.png"}}" width="256" height="256" alt="" aria-hidden="true"><span>meet the human</span><span class="sr-only"> — about Erin</span></a>
                    <a class="camp-patch" href="#projects" data-section-link><img src="{{asset "images/patch-campfire.png"}}" width="256" height="256" alt="" aria-hidden="true"><span>making a little trouble</span><span class="sr-only"> — explore things I make</span></a>
                    <a class="resume-scrap" href="{{@site.url}}/resume/">the résumé ↗</a>
                    <span class="handwritten arrow-note" aria-hidden="true">yes, you can<br>touch stuff. ⤴</span>
                </div>
            </div>
                <a class="postcrossing-postcard" href="https://www.postcrossing.com/user/erinmikail">
                    <svg class="postcrossing-envelope" viewBox="0 0 320 180" aria-hidden="true" focusable="false">
                        <path class="envelope-paper" d="m10 18 296-5 4 150-297 4Z"/>
                        <path class="envelope-seams" d="m11 20 147 86L306 15M13 165l103-84m194 81L207 77"/>
                        <path class="envelope-flap" d="m11 19 295-5-148 91Z"/>
                        <path class="envelope-stamp" d="m240 26 48 1-1 47-49-1Z"/>
                        <path d="M263 61c-35-22-11-37 0-22 13-15 35 2 0 22Z" fill="#171717"/>
                        <g class="envelope-postmark" fill="none" stroke="#171717" stroke-width="2" opacity=".65">
                            <circle cx="228" cy="53" r="24"/>
                            <path d="M215 44h27m-24 17h20m-14-10h9M250 44c13-8 20 8 34 0m-34 8c13-8 20 8 34 0m-34 8c13-8 20 8 34 0"/>
                        </g>
                    </svg>
                    <span class="postcrossing-label">Postcrossing <span aria-hidden="true">↗</span></span>
                    <span class="postcrossing-note">postcards, not another inbox</span>
                    <span class="postcrossing-stats">28 sent / 28 received <span class="postcrossing-date">as of <time datetime="2026-11-12">12 Nov 2026</time></span></span>
                </a>
            <div class="page-bottom"><span>RENO → BROOKLYN → YOUR BROWSER</span><span>001</span></div>
        </div>
        <div class="paper-page welcome-page">
            <div class="page-eyebrow"><span>OPEN NOTEBOOK / PLEASE DO NOT BE NORMAL</span><span aria-hidden="true">✴</span></div>
            <div class="welcome-note">
                <span class="handwritten tiny-heading">the internet should be weirder.</span>
                <h2><span>CODE.</span><br><span>COMMUNITY.</span><br><em>A LITTLE CHAOS.</em></h2>
                <div class="welcome-badges">
                    <a class="camp-patch" href="#writing" data-section-link><img src="{{asset "images/patch-writing.png"}}" width="256" height="256" alt="" aria-hidden="true"><span>write it down</span><span class="sr-only"> — words &amp; ideas</span></a>
                    <a class="camp-patch" href="#projects" data-section-link><img src="{{asset "images/patch-projects.png"}}" width="256" height="256" alt="" aria-hidden="true"><span>make a mess</span><span class="sr-only"> — things I make</span></a>
                    <a class="camp-patch" href="#contact" data-section-link><img src="{{asset "images/patch-contact.png"}}" width="256" height="256" alt="" aria-hidden="true"><span>say hey</span><span class="sr-only"> — contact Erin</span></a>
                </div>
                <div class="reno-introduction" data-reno-introduction><p>{{@custom.introduction}}</p></div>
                <p class="welcome-signoff">Part field notes. Part experiment. Part “is this thing on?”<br>Pick a tab. Pull a thread. Make yourself at home.</p>
            </div>
            <a class="pink-note liftable" href="#writing" data-section-link>
                <span class="tape" aria-hidden="true"></span>
                <span class="note-label">UNFILTERED / OCCASIONALLY USEFUL</span>
                <span class="note-title">THOUGHTS.<br>WITH RECEIPTS.</span>
                <span class="note-link">Tutorials, rabbit holes &amp; other brain noise <span aria-hidden="true">↗</span></span>
                <span class="note-doodle" aria-hidden="true">✷</span>
                <svg class="foil-sticker foil-note" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#shape-star" fill="url(#foil-gold)"/><use href="#shape-star" fill="url(#foil-glare)"/></svg>
            </a>
            <div class="bottom-scraps">
                <details class="secret-note">
                    <summary>
                        <svg class="lightbulb-doodle" viewBox="0 0 90 90" aria-hidden="true" focusable="false">
                            <path class="lightbulb-fill" d="M45 15c-13-1-21 8-21 20 0 10 5 15 11 22l1 5 18-1 1-5c6-7 11-13 11-22 0-11-8-19-21-19Z"/>
                            <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M45 14c-13-1-22 8-22 21 0 10 6 16 11 22l2 5 19-1 1-5c7-8 11-14 11-23 0-12-9-19-22-19Z"/>
                                <path d="M39 61 35 42l8 7 3-9 4 9 6-7-5 18M37 67l17-1M39 72l13-1M42 77l7-1"/>
                                <path d="M45 3 44 9M15 12l7 6M74 13l-6 6M5 35l8-1M77 34l8 1M13 57l7-4M71 54l7 4"/>
                            </g>
                        </svg>
                        <span class="sr-only">Open note</span>
                    </summary>
                    <p>You do not have to monetize every hobby. Make something weird. Be bad at it. Have a good time anyway.</p>
                </details>
                <a class="hello-ticket liftable" href="#contact" data-section-link><span>ALL AGES / ALL IDEAS</span><strong>LET'S TALK.</strong><span>NO NETWORKING VOICE REQUIRED ↗</span><svg class="foil-sticker foil-ticket" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#shape-bolt" fill="url(#foil-silver)"/><use href="#shape-bolt" fill="url(#foil-glare)"/></svg></a>
            </div>
            <div class="clippings"><a href="https://www.lu.ma/erinmikail">CATCH ME IRL ↗</a><a href="https://github.com/erinmikailstaples">LOOK AT THE CODE ↗</a></div>
            <div class="page-bottom"><span>CLICK A SCRAP. FOLLOW A THREAD.</span><span>002</span></div>
        </div>
    </section>

    <section class="spread inner-spread" id="about" aria-labelledby="about-title" data-journal-page>
        <div class="paper-page section-cover">
            <span class="page-eyebrow">02 / THE HUMAN BEHIND THE NOTEBOOK</span>
            <span class="handwritten">a few things to know</span>
            <h2 id="about-title">MORE HUMAN.<br>LESS <em>PERSONAL BRAND.</em></h2>
            <svg class="foil-sticker foil-about" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#shape-sparkle" fill="url(#foil-rose)"/><use href="#shape-sparkle" fill="url(#foil-glare)"/></svg>
            <img class="about-portrait" src="{{#if @custom.portrait}}{{img_url @custom.portrait size="large"}}{{else}}{{asset "images/erin-headshot.jpg"}}{{/if}}" alt="Erin Mikail Staples at a developer event" width="800" height="836" loading="lazy">
        </div>
        <div class="paper-page section-content">
            {{#get "pages" filter="slug:about" limit="1"}}
                {{#foreach pages}}
                    {{#if html}}<article class="gh-content">{{content}}</article>{{else}}{{> "bio"}}{{/if}}
                {{else}}
                    {{> "bio"}}
                {{/foreach}}
            {{/get}}
            {{#if @site.navigation}}<div class="extra-links"><h3>Other corners of my internet</h3>{{navigation}}</div>{{/if}}
        </div>
    </section>

    <section class="spread inner-spread" id="writing" aria-labelledby="writing-title" data-journal-page>
        <div class="paper-page section-cover">
            <span class="page-eyebrow">03 / WORDS &amp; IDEAS</span>
            <span class="handwritten">from the margins of my brain</span>
            <h2 id="writing-title">THINKING<br><em>OUT LOUD.</em></h2>
            <p>Developer experience, AI, tutorials, and the occasional bad joke. Learn something. Break something. Tell me what happened.</p>
            <img class="section-patch" src="{{asset "images/patch-writing.png"}}" width="256" height="256" alt="" aria-hidden="true" loading="lazy">
            <svg class="foil-sticker foil-writing" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#shape-moon" fill="url(#foil-silver)"/><use href="#shape-moon" fill="url(#foil-glare)"/></svg>
        </div>
        <div class="paper-page section-content">
            <span class="page-eyebrow">THE LATEST ENTRIES</span>
            {{#foreach posts}}{{> "post-card"}}{{else}}
                <div class="empty-note"><h3>A fresh page.</h3><p>Nothing published here just yet. Good thoughts take their own sweet time.</p></div>
            {{/foreach}}
            {{pagination}}
        </div>
    </section>

    <section class="spread inner-spread" id="projects" aria-labelledby="projects-title" data-journal-page>
        <div class="paper-page section-cover">
            <span class="page-eyebrow">04 / THINGS I MAKE</span>
            <span class="handwritten">a little trial. a little error.</span>
            <h2 id="projects-title">FUCK AROUND.<br><em>FIND THINGS OUT.</em></h2>
            <p>Demos, tutorials, experiments, and the occasional “I wonder what happens if…”</p>
            <img class="section-patch" src="{{asset "images/patch-projects.png"}}" width="256" height="256" alt="" aria-hidden="true" loading="lazy">
        </div>
        <div class="paper-page section-content">
            <span class="page-eyebrow">COLLECTED EXPERIMENTS</span>
            {{#get "posts" filter="tag:[hash-project,how-to]" include="tags,authors" limit="6"}}
                {{#foreach posts}}{{> "post-card"}}{{else}}
                    <div class="empty-note"><h3>Room for a little weird.</h3><p>The next experiment will land here. Glue is probably still drying.</p></div>
                {{/foreach}}
            {{/get}}
            <a class="text-link" href="#writing" data-section-link>Every entry, including older experiments ↗</a>
        </div>
    </section>

    <section class="spread inner-spread" id="contact" aria-labelledby="contact-title" data-journal-page>
        <div class="paper-page section-cover">
            <span class="page-eyebrow">05 / LEAVE A LITTLE NOTE</span>
            <span class="handwritten">the internet is better with people</span>
            <h2 id="contact-title">GOOD PEOPLE.<br>WEIRD IDEAS.<br><em>SAY HEY.</em></h2>
            <img class="section-patch" src="{{asset "images/patch-contact.png"}}" width="256" height="256" alt="" aria-hidden="true" loading="lazy">
            <svg class="foil-sticker foil-contact" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="#shape-flower" fill="url(#foil-lime)"/><use href="#shape-flower" fill="url(#foil-glare)"/></svg>
        </div>
        <div class="paper-page section-content contact-content">
            {{#get "pages" filter="slug:contact" limit="1"}}
                {{#foreach pages}}<article class="gh-content">{{content}}</article>{{else}}
                    <h3>Pull up a metaphorical chair.</h3>
                    <p>An interesting idea? A question? A delightfully specific thing you think I'd like? Those are all good reasons to get in touch.</p>
                {{/foreach}}
            {{/get}}
            {{#if @custom.contact_email}}
                <a class="contact-link" href="mailto:{{@custom.contact_email}}">Send me a note <span aria-hidden="true">↗</span></a>
            {{else}}
                <p class="contact-pending">The address card isn't filled in yet. Check back for a way to get in touch.</p>
            {{/if}}
            {{#if @site.secondary_navigation}}<div class="extra-links"><h3>Find me elsewhere</h3>{{navigation type="secondary"}}</div>{{/if}}
            <span class="handwritten">real humans. real connections.</span>
        </div>
    </section>
</div>
